# ─── Ambiente ───────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# PostgreSQL (via PgBouncer)
DATABASE_URL=postgresql://licitacao_user:licitacao_pass@pgbouncer:6432/licitacao_db

# MongoDB
MONGODB_URL=mongodb://admin:admin_pass@mongodb:27017/licitacao_db?authSource=admin

# Redis
REDIS_URL=redis://:redis_pass@redis:6379/0

# JWT — ⚠️ OBRIGATÓRIO: O sistema não inicia sem esta chave
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=supersecretkeychangeinproduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 dias

# ─── LLM / IA — Escolha o provedor ──────────────────────────────────────────
# Valores: "openai" | "deepseek" | "gemini"
# Recomendado: deepseek (5x mais barato que OpenAI, excelente em PT-BR)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (API compatível com OpenAI — basta preencher a chave e mudar LLM_PROVIDER)
# Crie sua conta em: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# WhatsApp (Evolution API)
WHATSAPP_API_URL=https://api.evolution.com.br
WHATSAPP_API_KEY=sua_api_key_aqui
WHATSAPP_INSTANCE=licitacao

# E-mail (SendGrid)
SENDGRID_API_KEY=sua_sendgrid_key_aqui
EMAIL_FROM=alertas@meusaas.com