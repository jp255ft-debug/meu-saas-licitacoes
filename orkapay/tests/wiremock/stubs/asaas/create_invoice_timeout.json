{
  "request": {
    "method": "POST",
    "urlPath": "/api/v3/invoices",
    "headers": {
      "access_token": { "matches": ".*" }
    }
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "jsonBody": {
      "id": "inv_slow_12345",
      "status": "PENDING",
      "value": "{{jsonPath request.body '$.amount_cents'}}"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}