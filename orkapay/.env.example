# OrkaPay - Variáveis de Ambiente
# ================================

# Ambiente
NODE_ENV=development
APP_PORT=3000

# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orkapay

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# BaaS Providers
ASAAS_API_KEY=your_asaas_api_key
ASAAS_ENV=sandbox

STARKBANK_PROJECT_ID=your_starkbank_project_id
STARKBANK_PRIVATE_KEY=your_starkbank_private_key

CELCOIN_CLIENT_ID=your_celcoin_client_id
CELCOIN_CLIENT_SECRET=your_celcoin_client_secret

FITBANK_API_KEY=your_fitbank_api_key

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# JWT
JWT_SECRET=your_jwt_secret

# OrkaPay Config
ORCHESTRATOR_FEE_PIX=0.25
ORCHESTRATOR_FEE_BOLETO=0.50
REVENUE_SHARE_PERCENT=20
