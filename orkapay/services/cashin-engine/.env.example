# Cashin Engine — Variáveis de Ambiente
# =======================================

# Banco de Dados
DATABASE_URL=postgres://cashin:cashin@localhost:5432/cashin?sslmode=disable

# Servidor
SERVER_PORT=8080

# Autenticação (API Key:ClientID, separado por vírgula)
API_KEYS=demo-key:ClienteDemo,teste:Teste

# Provedor Asaas (Sandbox)
ASAAS_API_KEY=sandbox_xxx
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Logging
LOG_LEVEL=info
LOG_FORMAT=json