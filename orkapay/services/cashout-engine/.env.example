# Cashout Engine — Variáveis de Ambiente
# =======================================

# Banco de Dados
DATABASE_URL=postgres://cashout:cashout@localhost:5432/cashout?sslmode=disable

# Servidor
SERVER_PORT=8080

# Autenticação (API Key:ClientID, separado por vírgula)
API_KEYS=demo-key:ClienteDemo,teste:Teste

# Provedor Stark Bank (Sandbox)
STARKBANK_API_KEY=sandbox_xxx
STARKBANK_BASE_URL=https://sandbox.starkbank.com/v2

# Logging
LOG_LEVEL=info
LOG_FORMAT=json